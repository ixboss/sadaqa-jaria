<?xml version="1.0" encoding="utf-8"?>
<!--
    fullBackupContent (API <31) — auto backup excludes. The `.sadaqa` backup
    file is the user's data path; the raw sqlite db (WAL files), the extracted
    mushaf fonts and the audio caches stay device-local. Shared prefs
    (widget-state bridge + settings UI cache) remain included.
-->
<full-backup-content>
    <exclude domain="file" path="databases/" />
    <exclude domain="file" path="fonts/" />
    <exclude domain="file" path="audio/" />
    <exclude domain="file" path="starter/" />
</full-backup-content>
