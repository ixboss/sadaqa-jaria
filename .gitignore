# ============================================================================
#  .gitignore — إسلامي / Islami (Sadaqah Jariyah)
# ----------------------------------------------------------------------------
#  This is a NO-BUILD, ZERO-DEPENDENCY project: plain HTML, CSS and JS files
#  served statically. There is no node_modules, no dist, no compiled output.
#
#  Therefore this file is intentionally SHORT. Its only job is to keep OS
#  cruft, editor state, and local secrets out of the repository.
#
#  ⚠️  Every file this project actually ships is tracked on purpose:
#      index.html, features.js, app.js, config.js, sw.js, surah-meta.js,
#      manifest.json, .htaccess, robots.txt, sitemap.xml, security.txt,
#      README.md, LICENSE, CONTRIBUTING.md, CODE_OF_CONDUCT.md,
#      the icons/ directory (PNG app icons — required for PWA install),
#      the icon generator + validator scripts, and the review reports
#      01-bugs.md … 04-architecture.md
#
#  Do NOT add patterns here that could match any of the above.
# ============================================================================


# ----------------------------------------------------------------------------
#  Operating system cruft
# ----------------------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
# The classic macOS custom-folder-icon file is literally named "Icon\r"
# (with a carriage return). Commonly-written template rules `Icon?` or `/Icon?`
# ALSO match the `icons/` directory -- gitignore globs are case-insensitive on
# Windows/macOS and `?` matches any single char -- which silently excludes every
# app icon and breaks PWA install. Use a character class that cannot match 's'.
Icon[\r]
Icon
.fseventsd
.TemporaryItems

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.Trash-*
.nfs*


# ----------------------------------------------------------------------------
#  Editors & IDEs
# ----------------------------------------------------------------------------

.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json.example
!.vscode/launch.json.example

.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*.swn
.netrwhist
Session.vim
.nvim.lua

# Emacs
*~
\#*\#
.\#*
.#*
auto-save-list

# Kate / others
*.kate-swp
*.kate-swp[0-9]

# NetBeans
nbproject/private/

# Eclipse
.classpath
.project
.settings/


# ----------------------------------------------------------------------------
#  Local tooling & scratch space
# ----------------------------------------------------------------------------

# Temporary scratch directories used during local development
.tmp/
.temp/
.tmp-*/
scratch/
sandbox/

# Local server / tunnel tooling
.ngrok*
cloudflared*
*.pem
*.key

# Local test output
test-results/
coverage/
*.log


# ----------------------------------------------------------------------------
#  Logs
# ----------------------------------------------------------------------------

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ----------------------------------------------------------------------------
#  Secrets & local configuration
# ----------------------------------------------------------------------------
#  Never commit credentials. If you need per-environment values locally,
#  use a *.local file — it stays out of the repo.

.env
.env.*
!.env.example
*.local
*.local.*
!.local.example

# Deployment credentials and host-specific config
deploy.json
ftpconfig.json
.sftp-config.json
.deploy-*
.netrc
_netrc

# Local overrides of Apache config (the committed .htaccess is tracked)
.htaccess.local
.htpasswd


# ----------------------------------------------------------------------------
#  Package managers — present ONLY to guard against accidental commits
# ----------------------------------------------------------------------------
#  This project has no dependencies and no build step. If you find yourself
#  creating any of these, something has gone wrong — see README.md
#  "Dependencies" and CONTRIBUTING.md "Contributions We Cannot Accept".

node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
package.json
!tests/package.json

vendor/
composer.json
composer.lock

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

dist/
build/
.cache/
.parcel-cache/
.next/
.nuxt/
.output/


# ----------------------------------------------------------------------------
#  Build/transpile artifacts that may appear if tooling is run experimentally
# ----------------------------------------------------------------------------

*.min.css.map
*.min.js.map
.eslintcache
.stylelintcache
.prettiercache
tsconfig.tsbuildinfo

# Compiled stylesheet/script output — the project ships readable source only
# NOTE: named explicitly so they can never shadow a real source file
index.min.html
features.min.js
app.min.js
sw.min.js


# ----------------------------------------------------------------------------
#  AI assistant / agent working directories
# ----------------------------------------------------------------------------
#  Local planning and memory state, not part of the shipped project.

.workbuddy-ai/
.workbuddy/
.cursor/
.claude/
.zcode/
.zcodeignore
.aider*
.github/copilot-instructions.local.md


# ============================================================================
#  END OF FILE
#
#  Reminder: if you are about to add a pattern here, ask first —
#  "could this ever match a file the project needs to ship?"
#  If the answer is yes, don't add it.
# ============================================================================
