<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: the widget extension reads widget-state.json + settings
	     written by the app (prayer countdown + daily dhikr pick). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.sadaqa.shared</string>
	</array>
	<!-- iCloud Drive `.sadaqa` hook: exports land in the app's iCloud Drive
	     container when iCloud is signed in; document-picker fallback needs none. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.sadaqa.ios</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.sadaqa.ios</string>
	</array>
</dict>
</plist>
