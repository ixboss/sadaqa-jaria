{
  "$schema": "sadaqa-design-tokens-v1",
  "meta": {
    "name": "Sadaqa Jaria v2 Design Tokens",
    "version": "1.0.0",
    "generated": "tokens.css via scripts/tools/gen-tokens.mjs",
    "glassPolicy": {
      "allowedOn": ["tabbar", "search-pill", "miniplayer", "toolbar"],
      "forbiddenOn": ["mushaf-page", "athkar-card", "prayer-card", "tool-card", "sheet-content"],
      "rule": "Liquid Glass strictly on the control layer; never glass-on-glass (REA_SPEC S-10)"
    }
  },
  "themes": {
    "light": {
      "bg": "#FAF7F0",
      "surface": "#FFFFFF",
      "surfaceRaised": "#F1ECE1",
      "textPrimary": "#1C2833",
      "textSecondary": "#56656D",
      "accent": "#8A6D1D",
      "accentContrast": "#FFFDF6",
      "border": "#DCD3C0",
      "mushafText": "#1C1812",
      "mushafBg": "#FAF7F0"
    },
    "sepia": {
      "bg": "#F4E8D0",
      "surface": "#FAF1DE",
      "surfaceRaised": "#EBDDBE",
      "textPrimary": "#3E2E1D",
      "textSecondary": "#6B543C",
      "accent": "#7A5C10",
      "accentContrast": "#FDF8EA",
      "border": "#D3C29C",
      "mushafText": "#2E2314",
      "mushafBg": "#F4E8D0"
    },
    "dark": {
      "bg": "#07110F",
      "surface": "#0D1B18",
      "surfaceRaised": "#122521",
      "textPrimary": "#F0F4F3",
      "textSecondary": "#9BB3AE",
      "accent": "#E5C158",
      "accentContrast": "#111612",
      "border": "#1B352F",
      "mushafText": "#F4EFE4",
      "mushafBg": "#07110F"
    },
    "oled": {
      "bg": "#000000",
      "surface": "#0A0A0A",
      "surfaceRaised": "#141414",
      "textPrimary": "#EAEAEA",
      "textSecondary": "#9BA3A7",
      "accent": "#E7C14C",
      "accentContrast": "#120C03",
      "border": "#222222",
      "mushafText": "#F2EFE6",
      "mushafBg": "#000000"
    }
  },
  "contrastPairs": [
    { "fg": "textPrimary", "bg": "bg", "min": 4.5, "label": "body text" },
    { "fg": "textSecondary", "bg": "bg", "min": 4.5, "label": "secondary text" },
    { "fg": "accent", "bg": "bg", "min": 4.5, "label": "accent as text/icon" },
    { "fg": "accentContrast", "bg": "accent", "min": 4.5, "label": "text on accent fills" },
    { "fg": "mushafText", "bg": "mushafBg", "min": 4.5, "label": "mushaf plate text (REA_SPEC 1.3)" }
  ],
  "typography": {
    "quranFamily": "'QPC Uthmanic HAFS', 'Amiri Quran', serif",
    "uiFamily": "'Noto Naskh Arabic', 'Segoe UI', system-ui, sans-serif",
    "arabicLineHeight": 1.9,
    "countLineHeight": 1.1,
    "fontScaleSteps": [0.8, 1.0, 1.3, 1.5, 2.0],
    "defaultFontScale": 1.3,
    "mushafPlateBase": "clamp(22px, 5.2vw, 40px)",
    "tabularNumerals": "'tnum' 1"
  },
  "radii": {
    "xs": "8px",
    "sm": "12px",
    "md": "18px",
    "lg": "26px",
    "pill": "999px",
    "rule": "concentric: outer radius = inner radius + container padding"
  },
  "spacing": {
    "unit": "4px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "20px",
    "xl": "32px"
  },
  "glass": {
    "fill": "rgba(13, 27, 24, 0.72)",
    "fillStrong": "rgba(18, 37, 33, 0.84)",
    "blur": "28px",
    "saturate": "1.9",
    "borderHighlight": "rgba(255, 255, 255, 0.16)",
    "shadow": "0 12px 36px rgba(0, 0, 0, 0.44)"
  },
  "motion": {
    "springs": {
      "pageFlip": { "damping": 0.85, "durationMs": 380 },
      "sheet": { "damping": 0.9, "durationMs": 320 },
      "tabMorph": { "damping": 0.75, "durationMs": 420 }
    },
    "durations": {
      "tick": 150,
      "complete": 450,
      "chromeFade": 220,
      "prayerSwitch": 320
    },
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "haptics": {
    "dhikrTick": [10],
    "dhikrComplete": [20, 60, 20, 60, 40],
    "categoryComplete": [40, 120, 40, 120, 40],
    "pageFlipSettle": [15],
    "bookmarkSaved": [25, 60, 25]
  },
  "numerals": {
    "supportedStyles": ["latin", "arabic_indic"],
    "default": "arabic_indic"
  }
}
